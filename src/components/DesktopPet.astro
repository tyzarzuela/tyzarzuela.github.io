<!-- Mascota virtual con melodías variadas y diálogos dinámicos -->
<div 
  id="desktop-pet" 
  class="fixed z-40 select-none cursor-pointer text-3xl pointer-events-auto"
  style="bottom: 40px; left: 0px;"
  title="¡Haz clic para interactuar con la oveja!"
>
  🐑
</div>

<style>
  @keyframes stepBounce {
    0%, 100% { transform: translateY(0) var(--pet-scale); }
    50% { transform: translateY(-4px) var(--pet-scale); }
  }

  .walking {
    animation: stepBounce 0.4s infinite ease-in-out;
  }
</style>

<script is:inline>
  (function initWalkingPet() {
    const pet = document.getElementById('desktop-pet');
    if (!pet) return;

    let posX = 50;
    let direction = 1; 
    const speed = 0.8; 

    pet.style.setProperty('--pet-scale', 'scaleX(-1)');
    pet.classList.add('walking');

    function animatePet() {
      const screenWidth = window.innerWidth;
      const petWidth = 45;

      posX += speed * direction;

      if (posX > screenWidth - petWidth) {
        direction = -1;
        pet.style.setProperty('--pet-scale', 'scaleX(1)');
      } else if (posX < 0) {
        direction = 1;
        pet.style.setProperty('--pet-scale', 'scaleX(-1)');
      }

      pet.style.left = posX + 'px';
      requestAnimationFrame(animatePet);
    }

    requestAnimationFrame(animatePet);

    // Variedad de melodías chiptune aleatorias de 8 bits
    function playRandomChiptune() {
      const AudioContext = window.AudioContext || window.webkitAudioContext;
      if (!AudioContext) return;
      const ctx = new AudioContext();

      // Diferentes patrones de notas para que suene variado en cada clic
      const songPatterns = [
        [523.25, 659.25, 783.99, 1046.50], // Acorde alegre ascendente
        [880.00, 783.99, 659.25, 523.25], // Secuencia descendente
        [440.00, 554.37, 659.25, 880.00, 987.77], // Escala armónica
        [659.25, 523.25, 783.99, 392.00]  // Arpegio divertido
      ];

      const chosenMelody = songPatterns[Math.floor(Math.random() * songPatterns.length)];

      chosenMelody.forEach((freq, index) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();

        osc.type = 'square'; // Sonido retro clásico de consola
        osc.frequency.value = freq;

        const noteTime = ctx.currentTime + (index * 0.12);
        gain.gain.setValueAtTime(0.04, noteTime);
        gain.gain.exponentialRampToValueAtTime(0.001, noteTime + 0.1);

        osc.connect(gain);
        gain.connect(ctx.destination);

        osc.start(noteTime);
        osc.stop(noteTime + 0.11);
      });
    }

    // Interacción al hacer clic con textos variados y música
    pet.addEventListener('click', () => {
      playRandomChiptune();

      const interactions = [
        "🎵 ¡Baaa! La oveja toca unos acordes de 8 bits.",
        "🎮 ¡Modo videojuego retro activado por la mascota de Claudia!",
        "✨ ¡Sintetizador MIDI portátil funcionando al 100%!",
        "🐑 ¡Baa! Gracias por audicionar este tema chiptune.",
        "💤 ¡La oveja se ha tomado un descanso musical y vuelve a caminar!"
      ];

      const randomText = interactions[Math.floor(Math.random() * interactions.length)];
      alert(randomText);
    });
  })();
</script>