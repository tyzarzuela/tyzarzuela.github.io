---
---
<!-- Mascota virtual con burbuja de diálogo integrada -->
<div id="pet-container" class="fixed z-40 select-none pointer-events-auto" style="bottom: 40px; left: 0px;">
  <!-- Bocadillo de diálogo flotante -->
  <div 
    id="pet-speech" 
    class="hidden absolute bottom-10 left-1/2 -translate-x-1/2 bg-[#ffffe1] text-black text-[11px] font-mono px-2 py-1 win-border shadow-md whitespace-nowrap z-50 animate-fade-in"
  >
    ¡Baaa!
  </div>

  <!-- La oveja -->
  <div 
    id="desktop-pet" 
    class="cursor-pointer text-3xl"
    title="¡Haz clic para interactuar con la oveja!"
  >
    🐑
  </div>
</div>

<style>
  @keyframes stepBounce {
    0%, 100% { transform: translateY(0) var(--pet-scale); }
    50% { transform: translateY(-4px) var(--pet-scale); }
  }

  .walking {
    animation: stepBounce 0.4s infinite ease-in-out;
  }
</style>

<script is:inline>
  (function initWalkingPet() {
    const container = document.getElementById('pet-container');
    const pet = document.getElementById('desktop-pet');
    const speech = document.getElementById('pet-speech');
    if (!container || !pet || !speech) return;

    let posX = 50;
    let direction = 1; 
    const speed = 0.8; 
    let hideTimeout = null;

    pet.style.setProperty('--pet-scale', 'scaleX(-1)');
    pet.classList.add('walking');

    function animatePet() {
      const screenWidth = window.innerWidth;
      const petWidth = 45;

      posX += speed * direction;

      if (posX > screenWidth - petWidth) {
        direction = -1;
        pet.style.setProperty('--pet-scale', 'scaleX(1)');
      } else if (posX < 0) {
        direction = 1;
        pet.style.setProperty('--pet-scale', 'scaleX(-1)');
      }

      container.style.left = posX + 'px';
      requestAnimationFrame(animatePet);
    }

    requestAnimationFrame(animatePet);

    // Reproductor chiptune aleatorio
    function playRandomChiptune() {
      const AudioContext = window.AudioContext || window.webkitAudioContext;
      if (!AudioContext) return;
      const ctx = new AudioContext();

      const songPatterns = [
        [523.25, 659.25, 783.99, 1046.50], 
        [880.00, 783.99, 659.25, 523.25], 
        [440.00, 554.37, 659.25, 880.00, 987.77], 
        [659.25, 523.25, 783.99, 392.00]  
      ];

      const chosenMelody = songPatterns[Math.floor(Math.random() * songPatterns.length)];

      chosenMelody.forEach((freq, index) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();

        osc.type = 'square';
        osc.frequency.value = freq;

        const noteTime = ctx.currentTime + (index * 0.12);
        gain.gain.setValueAtTime(0.04, noteTime);
        gain.gain.exponentialRampToValueAtTime(0.001, noteTime + 0.1);

        osc.connect(gain);
        gain.connect(ctx.destination);

        osc.start(noteTime);
        osc.stop(noteTime + 0.11);
      });
    }

    // Interacción al hacer clic mostrando un bocadillo en lugar de un alert
    pet.addEventListener('click', () => {
      playRandomChiptune();

      const interactions = [
        "🎵 ¡Baaa! Acordes de 8 bits.",
        "🎮 ¡Modo retro activado!",
        "✨ ¡Sintetizador operativo!",
        "🐑 ¡Hola desde Windows 98!",
        "💤 ¡Zzz... Sigo caminando!"
      ];

      const randomText = interactions[Math.floor(Math.random() * interactions.length)];
      
      speech.innerText = randomText;
      speech.classList.remove('hidden');

      // Ocultar el bocadillo automáticamente tras 3 segundos
      if (hideTimeout) clearTimeout(hideTimeout);
      hideTimeout = setTimeout(() => {
        speech.classList.add('hidden');
      }, 3000);
    });
  })();
</script>