---
interface Props {
  id: string;
  title: string;
  defaultW?: string;
  defaultH?: string;
  maxW?: string;
  maxH?: string;
  initialTop?: string;
  initialLeft?: string;
}

const { 
  id, 
  title, 
  defaultW = '600px', 
  defaultH = '380px', 
  maxW = '850px', 
  maxH = '550px',
  initialTop = '48px',
  initialLeft = '80px'
} = Astro.props;
---

<div 
  id={id} 
  class="win-resizable hidden absolute bg-[#c0c0c0] win-border p-[2px] shadow-2xl flex flex-col z-30"
  style={`width: ${defaultW}; height: ${defaultH}; top: ${initialTop}; left: ${initialLeft};`}
>
  <div class="window-header title-bar-gradient text-white px-1 py-[2px] flex justify-between items-center font-bold text-sm cursor-move shrink-0">
    <span class="flex items-center gap-1 pointer-events-none">{title}</span>
    <div class="flex gap-[2px]">
      <button onclick={`toggleMaximize('${id}', '${defaultW}', '${defaultH}', '${maxW}', '${maxH}')`} class="w-4 h-4 bg-[#c0c0c0] text-black win-border win-btn flex items-center justify-center text-xs font-bold">◻</button>
      <button onclick={`closeWin('${id}')`} class="w-4 h-4 bg-[#c0c0c0] text-black win-border win-btn flex items-center justify-center text-xs font-bold">X</button>
    </div>
  </div>
  <slot />
</div>