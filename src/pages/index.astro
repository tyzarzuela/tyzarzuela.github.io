---
import '../styles/global.css';
---

<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Claudia's Arcade Quest | Game Dev Portfolio</title>
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
	</head>
	<body class="bg-purple-950 text-amber-300 font-['Press_Start_2P'] antialiased min-h-screen flex flex-col items-center justify-center p-2 md:p-6 select-none">

		<!-- MARCO DE MÁQUINA ARCADE -->
		<div class="w-full max-w-4xl bg-pink-600 p-4 md:p-8 rounded-3xl border-8 border-yellow-400 shadow-[0_0_50px_rgba(236,72,153,0.5)] relative">
			
			<!-- HEADER DE LA MÁQUINA ARCADE -->
			<div class="bg-indigo-950 border-4 border-cyan-400 p-4 rounded-xl mb-4 flex flex-wrap justify-between items-center text-[10px] md:text-xs">
				<div class="text-yellow-300 animate-pulse">SCORE: <span id="score">00000</span></div>
				<div class="text-pink-400">STAGE: <span id="stage-num">1 - DEV SPACE</span></div>
				<div class="text-cyan-300">LIVES: ❤️❤️❤️</div>
			</div>

			<!-- PANTALLA CRT DEL JUEGO (CANVAS) -->
			<div class="relative w-full aspect-video bg-slate-950 rounded-xl overflow-hidden border-4 border-purple-900 shadow-inner">
				<canvas id="game-canvas" class="w-full h-full block cursor-crosshair"></canvas>
				
				<!-- OVERLAY CRT (LÍNEAS DE ESCANEO ARCADE) -->
				<div class="absolute inset-0 bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.4)_50%)] bg-[length:100%_4px] pointer-events-none opacity-60"></div>

				<!-- MENÚ INICIAL SOBRE LA PANTALLA -->
				<div id="game-overlay" class="absolute inset-0 bg-indigo-950/90 flex flex-col items-center justify-center p-6 text-center z-10 transition-opacity">
					<h1 class="text-xl md:text-3xl text-yellow-300 mb-4 animate-bounce leading-relaxed">
						CLAUDIA'S ARCADE
					</h1>
					<p class="text-pink-400 text-[10px] md:text-xs mb-6 max-w-md leading-loose">
						SHOOT THE BUGS & POWER-UPS TO UNLOCK MY GAME DEV PROJECTS!
					</p>
					<button id="start-btn" class="px-6 py-4 bg-yellow-400 hover:bg-yellow-300 text-indigo-950 font-bold text-xs rounded-xl border-4 border-pink-500 shadow-[4px_4px_0px_0px_rgba(236,72,153,1)] active:translate-x-1 active:translate-y-1 active:shadow-none transition-all cursor-pointer">
						[ CLICK TO PLAY ]
					</button>
				</div>
			</div>

			<!-- PANEL DE CONTROLES INFERIOR -->
			<div class="mt-4 flex flex-wrap justify-between items-center text-[10px] text-indigo-900 font-bold bg-pink-500 p-3 rounded-xl border-2 border-yellow-300">
				<span>CONTROLS: MOUSE TO AIM/SHOOT OR ARROWS + SPACE</span>
				<span>INSERT COIN [00]</span>
			</div>

			<!-- CONTENEDOR DE DESBLOQUEOS (PROJECTS) -->
			<div id="unlocks-container" class="mt-8 space-y-4">
				<h2 class="text-xs text-yellow-300 text-center mb-4">=== UNLOCKED DATA LOGS ===</h2>
				
				<div id="log-vr" class="hidden bg-indigo-900/90 border-4 border-cyan-400 p-4 rounded-xl text-xs text-cyan-200">
					<span class="text-yellow-300 font-bold">[UNLOCKED] VR LLM INTERACTION SYSTEM</span>
					<p class="text-[10px] mt-2 text-slate-300 font-sans leading-relaxed">
						Bachelor thesis project. UE5 game prototype executing dynamic open-source LLMs via C++ and Blueprints.
					</p>
				</div>

				<div id="log-engine" class="hidden bg-indigo-900/90 border-4 border-pink-400 p-4 rounded-xl text-xs text-pink-200">
					<span class="text-yellow-300 font-bold">[UNLOCKED] EDEN CUSTOM ENGINE</span>
					<p class="text-[10px] mt-2 text-slate-300 font-sans leading-relaxed">
						2D/3D custom engine built from scratch in C++ featuring ECS, custom rendering, and physics integration.
					</p>
				</div>
			</div>

		</div>

		<!-- JUEGO BÁSICO EN JAVASCRIPT -->
		<script is:inline>
			const canvas = document.getElementById('game-canvas');
			const ctx = canvas.getContext('2d');
			const startBtn = document.getElementById('start-btn');
			const overlay = document.getElementById('game-overlay');
			const scoreEl = document.getElementById('score');

			let score = 0;
			let isPlaying = false;
			let player = { x: 300, y: 350, w: 20, h: 20, speed: 5 };
			let bullets = [];
			let targets = [];

			function resizeCanvas() {
				canvas.width = canvas.parentElement.clientWidth;
				canvas.height = canvas.parentElement.clientHeight;
				player.x = canvas.width / 2;
				player.y = canvas.height - 40;
			}
			window.addEventListener('resize', resizeCanvas);
			resizeCanvas();

			// CONTROLES DE RATÓN
			canvas.addEventListener('mousemove', (e) => {
				const rect = canvas.getBoundingClientRect();
				player.x = e.clientX - rect.left;
			});

			canvas.addEventListener('click', () => {
				if (!isPlaying) return;
				bullets.push({ x: player.x, y: player.y, speed: 7 });
			});

			// GENERADOR DE OBJETIVOS (BUGS Y POWER-UPS)
			function spawnTarget() {
				if (!isPlaying) return;
				const types = [
					{ label: 'BUG', color: '#ef4444', score: 100, unlock: null },
					{ label: 'VR.UE5', color: '#22d3ee', score: 500, unlock: 'log-vr' },
					{ label: 'C++.ENGINE', color: '#ec4899', score: 500, unlock: 'log-engine' }
				];
				const type = types[Math.floor(Math.random() * types.length)];
				targets.push({
					x: Math.random() * (canvas.width - 60) + 30,
					y: -20,
					w: 60,
					h: 20,
					speed: Math.random() * 1.5 + 1,
					...type
				});
				setTimeout(spawnTarget, Math.random() * 1500 + 1000);
			}

			// BUCLE PRINCIPAL DEL JUEGO
			function gameLoop() {
				ctx.fillStyle = '#0f172a';
				ctx.fillRect(0, 0, canvas.width, canvas.height);

				if (isPlaying) {
					// DIBUJAR JUGADOR (NAVE)
					ctx.fillStyle = '#fde047';
					ctx.beginPath();
					ctx.moveTo(player.x, player.y - 15);
					ctx.lineTo(player.x - 15, player.y + 10);
					ctx.lineTo(player.x + 15, player.y + 10);
					ctx.closePath();
					ctx.fill();

					// BALAS
					for (let i = bullets.length - 1; i >= 0; i--) {
						const b = bullets[i];
						b.y -= b.speed;
						ctx.fillStyle = '#f43f5e';
						ctx.fillRect(b.x - 2, b.y, 4, 10);

						if (b.y < 0) bullets.splice(i, 1);
					}

					// OBJETIVOS
					for (let i = targets.length - 1; i >= 0; i--) {
						const t = targets[i];
						t.y += t.speed;

						// DIBUJAR CAJA
						ctx.fillStyle = t.color;
						ctx.fillRect(t.x - t.w/2, t.y - t.h/2, t.w, t.h);
						ctx.fillStyle = '#ffffff';
						ctx.font = '8px "Press Start 2P"';
						ctx.textAlign = 'center';
						ctx.fillText(t.label, t.x, t.y + 3);

						// COLISIONES
						for (let j = bullets.length - 1; j >= 0; j--) {
							const b = bullets[j];
							if (Math.abs(b.x - t.x) < t.w/2 && Math.abs(b.y - t.y) < t.h/2) {
								score += t.score;
								scoreEl.innerText = String(score).padStart(5, '0');

								if (t.unlock) {
									const el = document.getElementById(t.unlock);
									if (el) el.classList.remove('hidden');
								}

								targets.splice(i, 1);
								bullets.splice(j, 1);
								break;
							}
						}

						if (t.y > canvas.height + 20) targets.splice(i, 1);
					}
				}

				requestAnimationFrame(gameLoop);
			}

			startBtn.addEventListener('click', () => {
				overlay.classList.add('opacity-0', 'pointer-events-none');
				isPlaying = true;
				spawnTarget();
			});

			gameLoop();
		</script>

	</body>
</html>