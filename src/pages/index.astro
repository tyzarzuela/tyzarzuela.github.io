---
import '../styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Claudia OS - Windows 98 Edition</title>
		
		<style>
			/* Tipografía auténtica de Win98 para legibilidad perfecta */
			body {
				font-family: Tahoma, 'Segoe UI', Geneva, Verdana, sans-serif;
			}
			/* Biseles Retro */
			.win-border {
				border: 2px solid;
				border-top-color: #dfdfdf;
				border-left-color: #dfdfdf;
				border-right-color: #000000;
				border-bottom-color: #000000;
				box-shadow: inset 1px 1px 0px 0px #ffffff, inset -1px -1px 0px 0px #808080;
			}
			.win-border-inset {
				border: 2px solid;
				border-top-color: #808080;
				border-left-color: #808080;
				border-right-color: #ffffff;
				border-bottom-color: #ffffff;
				box-shadow: inset 1px 1px 0px 0px #000000, inset -1px -1px 0px 0px #dfdfdf;
			}
			.win-btn:active {
				border-top-color: #000000;
				border-left-color: #000000;
				border-right-color: #ffffff;
				border-bottom-color: #ffffff;
				box-shadow: inset 1px 1px 0px 0px #808080;
			}
			.title-bar-gradient {
				background: linear-gradient(90deg, #000080 0%, #1084d0 100%);
			}
			/* Clase para ventana maximizada */
			.is-maximized {
				top: 0 !important;
				left: 0 !important;
				transform: none !important;
				width: 100% !important;
				height: calc(100vh - 40px) !important; /* Restar barra de tareas */
				max-width: none !important;
			}
		</style>
	</head>

	<body class="bg-[#008080] text-sm min-h-screen overflow-hidden select-none relative">

		<!-- ICONOS DEL ESCRITORIO (IZQUIERDA - TRABAJO) -->
		<div class="absolute top-6 left-6 grid grid-cols-1 gap-6 w-24 z-10">
			<button onclick="openWin('win-about')" class="flex flex-col items-center gap-1 group">
				<img src="https://win98icons.alexmeub.com/icons/png/computer_explorer-4.png" alt="PC" class="w-10 h-10 pixelated" />
				<span class="text-white text-xs text-center leading-tight px-1 group-focus:bg-[#000080] group-focus:border-dotted group-focus:border border-transparent">About_Me</span>
			</button>

			<button onclick="openWin('win-projects')" class="flex flex-col items-center gap-1 group">
				<img src="https://win98icons.alexmeub.com/icons/png/directory_open_file_mydocs-4.png" alt="Folder" class="w-10 h-10 pixelated" />
				<span class="text-white text-xs text-center leading-tight px-1 group-focus:bg-[#000080] group-focus:border-dotted group-focus:border border-transparent">Projects</span>
			</button>
		</div>

		<!-- ICONOS DEL ESCRITORIO (DERECHA ABAJO - JUEGOS Y OCIO) -->
		<div class="absolute bottom-16 right-6 flex flex-col gap-6 w-24 z-10 items-end">
			<button onclick="alert('Iniciando Hollow Knight... ¡Ojalá! 🐛')" class="flex flex-col items-center gap-1 group">
				<div class="text-3xl drop-shadow-md">🗡️</div>
				<span class="text-white text-xs text-center leading-tight px-1 group-focus:bg-[#000080]">Hollow_Knight.exe</span>
			</button>

			<button onclick="alert('Half-Life 3 no confirmado aún. ☢️')" class="flex flex-col items-center gap-1 group">
				<div class="text-3xl drop-shadow-md">☢️</div>
				<span class="text-white text-xs text-center leading-tight px-1 group-focus:bg-[#000080]">Half_Life.exe</span>
			</button>
			
			<button onclick="alert('ERROR: Demasiadas ideas sin terminar aquí dentro. 🗑️')" class="flex flex-col items-center gap-1 group">
				<img src="https://win98icons.alexmeub.com/icons/png/recycle_bin_full-4.png" alt="Trash" class="w-10 h-10 pixelated" />
				<span class="text-white text-xs text-center leading-tight px-1 group-focus:bg-[#000080]">Scrapped_Ideas</span>
			</button>
		</div>

		<!-- VENTANA: ABOUT ME -->
		<div id="win-about" class="hidden absolute top-12 left-1/2 -translate-x-1/2 w-[90%] max-w-md bg-[#c0c0c0] win-border p-[2px] shadow-2xl z-20 flex flex-col">
			<!-- Barra de Título -->
			<div class="title-bar-gradient text-white px-1 py-[2px] flex justify-between items-center font-bold text-sm cursor-default">
				<span class="flex items-center gap-1">
					<img src="https://win98icons.alexmeub.com/icons/png/computer_explorer-4.png" class="w-4 h-4" /> About_Me.exe
				</span>
				<div class="flex gap-[2px]">
					<button onclick="toggleMaximize('win-about')" class="w-4 h-4 bg-[#c0c0c0] text-black win-border win-btn flex items-center justify-center font-bold">◻</button>
					<button onclick="closeWin('win-about')" class="w-4 h-4 bg-[#c0c0c0] text-black win-border win-btn flex items-center justify-center font-bold">X</button>
				</div>
			</div>
			<!-- Contenido con Scroll -->
			<div class="p-3 overflow-y-auto max-h-[60vh]">
				<div class="flex items-start gap-4 mb-4">
					<img src="https://win98icons.alexmeub.com/icons/png/user_world-4.png" class="w-12 h-12" />
					<div>
						<h2 class="text-lg font-bold">Claudia Zarzuela Amor</h2>
						<p class="text-gray-700">Game Developer & Software Engineer</p>
					</div>
				</div>
				<div class="bg-white win-border-inset p-3 text-black text-sm mb-4">
					<p class="mb-2"><strong>Level:</strong> Pro</p>
					<p class="mb-2"><strong>Classes:</strong> C++, Unreal Engine 5, VR Systems, AI integration.</p>
					<p>Warning: May talk about Game Architecture for hours if prompted.</p>
				</div>
				<div class="flex justify-end">
					<button onclick="closeWin('win-about')" class="bg-[#c0c0c0] px-4 py-1 win-border win-btn text-sm">OK</button>
				</div>
			</div>
		</div>

		<!-- VENTANA: PROJECTS -->
		<div id="win-projects" class="hidden absolute top-20 left-1/2 -translate-x-1/2 w-[90%] max-w-3xl bg-[#c0c0c0] win-border p-[2px] shadow-2xl z-30 flex flex-col">
			<div class="title-bar-gradient text-white px-1 py-[2px] flex justify-between items-center font-bold text-sm">
				<span class="flex items-center gap-1">
					<img src="https://win98icons.alexmeub.com/icons/png/directory_open_file_mydocs-4.png" class="w-4 h-4" /> C:\Portfolio\Projects
				</span>
				<div class="flex gap-[2px]">
					<button onclick="toggleMaximize('win-projects')" class="w-4 h-4 bg-[#c0c0c0] text-black win-border win-btn flex items-center justify-center font-bold">◻</button>
					<button onclick="closeWin('win-projects')" class="w-4 h-4 bg-[#c0c0c0] text-black win-border win-btn flex items-center justify-center font-bold">X</button>
				</div>
			</div>
			<!-- Barra de menú falsa -->
			<div class="flex gap-4 px-2 py-1 bg-[#c0c0c0] border-b border-gray-400 text-xs">
				<span class="hover:bg-blue-800 hover:text-white px-1 cursor-pointer">File</span>
				<span class="hover:bg-blue-800 hover:text-white px-1 cursor-pointer">Edit</span>
				<span class="hover:bg-blue-800 hover:text-white px-1 cursor-pointer">View</span>
			</div>
			
			<!-- Contenido scrolleable -->
			<div class="p-4 overflow-y-auto max-h-[60vh] bg-white win-border-inset m-2 space-y-4 h-full">
				
				<div class="border-b border-dashed border-gray-400 pb-3">
					<div class="flex justify-between items-center mb-1">
						<span class="font-bold text-[#000080] text-lg flex items-center gap-2">
							🎮 VR LLM Interaction System
						</span>
						<span class="text-xs bg-[#c0c0c0] px-2 py-1 win-border-inset">UE5 / C++</span>
					</div>
					<p class="mb-2">VR game prototype executing dynamic open-source LLM prompts through custom Blueprints.</p>
					<a href="https://github.com/tyzarzuela" target="_blank" class="text-blue-600 underline hover:text-blue-800">Explore Source Code</a>
				</div>

				<div class="border-b border-dashed border-gray-400 pb-3">
					<div class="flex justify-between items-center mb-1">
						<span class="font-bold text-[#000080] text-lg flex items-center gap-2">
							⚙️ EDEN Custom Engine
						</span>
						<span class="text-xs bg-[#c0c0c0] px-2 py-1 win-border-inset">C++ / ECS</span>
					</div>
					<p class="mb-2">2D/3D game engine built from scratch. Features modular ECS, custom rendering pipeline, and physics.</p>
					<a href="https://github.com/tyzarzuela" target="_blank" class="text-blue-600 underline hover:text-blue-800">Explore Source Code</a>
				</div>

				<!-- Easter Egg en la carpeta -->
				<div class="pt-2 flex items-center gap-3 p-3 bg-yellow-100 border border-yellow-400 rounded">
					<span class="text-2xl">⚠️</span>
					<div>
						<p class="font-bold text-red-600">Top_Secret_Game_Idea.txt</p>
						<button onclick="alert('Access Denied: The world is not ready for a Battle Royale with pigeons yet. 🐦')" class="text-xs text-blue-600 underline">Open File</button>
					</div>
				</div>

			</div>
		</div>

		<!-- BARRA DE TAREAS (TASKBAR WINDOWS 98) -->
		<div class="fixed bottom-0 left-0 w-full h-10 bg-[#c0c0c0] border-t-[2px] border-white shadow-[0_-1px_0_0_#dfdfdf] flex justify-between items-center px-1 z-50">
			<div class="relative">
				<button id="start-btn" onclick="toggleStartMenu()" class="h-8 px-2 bg-[#c0c0c0] win-border win-btn flex items-center gap-2 font-bold text-black cursor-pointer">
					<img src="https://win98icons.alexmeub.com/icons/png/windows-4.png" class="w-5 h-5" />
					<span>Start</span>
				</button>
				<!-- Menú Inicio desplegable -->
				<div id="start-menu" class="hidden absolute bottom-10 left-0 w-56 bg-[#c0c0c0] win-border p-[2px] shadow-2xl flex">
					<div class="w-8 bg-gradient-to-b from-[#000080] to-[#1084d0] flex flex-col justify-end p-1">
						<span class="text-white text-sm font-bold -rotate-90 origin-left whitespace-nowrap mb-10 tracking-widest">ClaudiaOS 98</span>
					</div>
					<div class="flex-1 flex flex-col py-1 bg-[#c0c0c0]">
						<button onclick="openWin('win-projects'); toggleStartMenu()" class="px-3 py-2 text-left hover:bg-[#000080] hover:text-white flex items-center gap-3">
							<img src="https://win98icons.alexmeub.com/icons/png/directory_open_file_mydocs-4.png" class="w-6 h-6" /> Projects
						</button>
						<a href="https://github.com/tyzarzuela" target="_blank" class="px-3 py-2 text-left hover:bg-[#000080] hover:text-white flex items-center gap-3">
							<img src="https://win98icons.alexmeub.com/icons/png/network_internet_pcs_installer-2.png" class="w-6 h-6" /> GitHub Web
						</a>
						<div class="h-[2px] bg-gray-400 border-b border-white my-1 mx-2"></div>
						<a href="mailto:czarzuelamor@gmail.com" class="px-3 py-2 text-left hover:bg-[#000080] hover:text-white flex items-center gap-3">
							<img src="https://win98icons.alexmeub.com/icons/png/message_envelope_open-0.png" class="w-6 h-6" /> E-mail Me
						</a>
						<button onclick="alert('It is now safe to turn off your computer.'); toggleStartMenu()" class="px-3 py-2 text-left hover:bg-[#000080] hover:text-white flex items-center gap-3">
							<img src="https://win98icons.alexmeub.com/icons/png/shut_down_normal-2.png" class="w-6 h-6" /> Shut Down...
						</button>
					</div>
				</div>
			</div>
			<!-- Reloj -->
			<div class="h-7 px-3 bg-[#c0c0c0] win-border-inset flex items-center text-xs text-black" id="win-clock">
				12:00 PM
			</div>
		</div>

		<!-- SCRIPTS -->
		<script is:inline>
			let zIndexCounter = 40; // Para que la ventana clickeada pase al frente

			function bringToFront(id) {
				zIndexCounter++;
				document.getElementById(id).style.zIndex = zIndexCounter;
			}

			function openWin(id) {
				const win = document.getElementById(id);
				win.classList.remove('hidden');
				bringToFront(id);
			}

			function closeWin(id) {
				document.getElementById(id).classList.add('hidden');
			}

			function toggleMaximize(id) {
				const win = document.getElementById(id);
				win.classList.toggle('is-maximized');
				bringToFront(id);
			}

			function toggleStartMenu() {
				document.getElementById('start-menu').classList.toggle('hidden');
			}

			// Actualizar Reloj
			function updateClock() {
				const now = new Date();
				let hours = now.getHours();
				let minutes = now.getMinutes();
				const ampm = hours >= 12 ? 'PM' : 'AM';
				hours = hours % 12 || 12;
				minutes = minutes < 10 ? '0' + minutes : minutes;
				document.getElementById('win-clock').innerText = `${hours}:${minutes} ${ampm}`;
			}
			setInterval(updateClock, 1000);
			updateClock();

			// Hacer que al hacer click en las ventanas se vengan al frente
			document.querySelectorAll('[id^="win-"]').forEach(win => {
				win.addEventListener('mousedown', () => bringToFront(win.id));
			});
		</script>
	</body>
</html>