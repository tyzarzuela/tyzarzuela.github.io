---
import '../styles/global.css';
import { CATEGORIZED_PROJECTS } from '../data/projects';
import Window from '../components/Window.astro';
import DesktopGrid from '../components/DesktopGrid.astro';
import ProjectCard from '../components/ProjectCard.astro';
import DetailWindow from '../components/DetailWindow.astro';
import Taskbar from '../components/Taskbar.astro';
import DesktopPet from '../components/DesktopPet.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Claudia OS - Windows 98</title>
  </head>

  <body class="bg-[#008080] text-sm min-h-screen overflow-hidden select-none relative">

    <DesktopGrid />
    
    <!-- Mascota virtual del escritorio -->
    <DesktopPet />

    <!-- VENTANA PRINCIPAL DE PROYECTOS (Muestra las Carpetas) -->
    <Window id="win-projects" title="📁 Projects" defaultW="600px" defaultH="440px" initialTop="15%" initialLeft="20%">
      <div class="p-4 bg-white win-border-inset flex-1 overflow-y-auto win-scroll">
        <p class="text-xs text-gray-500 mb-4">Selecciona una carpeta para explorar las subcategorías:</p>
        
        <div class="grid grid-cols-3 gap-4">
          {CATEGORIZED_PROJECTS.map((folder) => (
            <button 
              onclick={`openWin('win-folder-${folder.id}')`}
              class="flex flex-col items-center justify-center p-3 hover:bg-blue-100 border border-transparent hover:border-blue-300 rounded cursor-pointer group"
            >
              <div class="text-4xl mb-1 group-hover:scale-105 transition-transform">{folder.icon}</div>
              <span class="text-xs font-bold text-black text-center group-hover:text-blue-900">{folder.name}</span>
              <span class="text-[10px] text-gray-500">{folder.projects.length} item(s)</span>
            </button>
          ))}
        </div>
      </div>
    </Window>

    <!-- VENTANAS SECUNDARIAS (Una por cada Carpeta) -->
    {CATEGORIZED_PROJECTS.map((folder) => (
      <Window 
        id={`win-folder-${folder.id}`} 
        title={`📁 C:\\Portfolio\\Projects\\${folder.name}`} 
        defaultW="600px" 
        defaultH="380px"
        initialTop="90px"
        initialLeft="140px"
      >
        <div class="p-3 bg-white win-border-inset flex-1 overflow-y-auto win-scroll space-y-4">
          {folder.projects.map((proj) => (
            <ProjectCard 
              id={proj.id}
              title={proj.title}
              tag={proj.tag}
              shortDesc={proj.shortDesc}
            />
          ))}
        </div>
      </Window>
    ))}

    <!-- VENTANAS DE DETALLE DE CADA PROYECTO -->
    {CATEGORIZED_PROJECTS.flatMap(f => f.projects).map((proj) => (
      <DetailWindow 
        id={proj.id}
        title={proj.title}
        description={proj.detail.description}
        whatIDid={proj.detail.whatIDid}
        mediaUrl={proj.detail.mediaUrl}
        githubUrl={proj.detail.githubUrl}
      />
    ))}

    <!-- Ventana About Me -->
    <Window id="win-about" title="💻 About_Me.exe" defaultW="640px" defaultH="480px" initialTop="10%" initialLeft="15%">
      <div class="p-4 bg-white win-border-inset flex-1 overflow-y-auto win-scroll space-y-4 text-xs text-black">
        
        <!-- Encabezado -->
        <div class="flex flex-wrap sm:flex-nowrap items-center gap-4 border-b border-gray-300 pb-3">
          <div class="w-16 h-16 bg-gray-300 win-border-inset flex items-center justify-center font-bold text-gray-600 text-xl shrink-0">
            👤
          </div>
          <div class="min-w-0 flex-1">
            <h1 class="text-base sm:text-lg font-bold text-[#000080] truncate">CLAUDIA ZARZUELA AMOR</h1>
            <p class="font-semibold text-gray-700 leading-tight">Video Game Development Degree | Software Engineer</p>
            <p class="mt-1 leading-tight text-gray-600">
              Passionate game developer with a strong technical background and creative mindset. Eager to expand skills in game design and AI.
            </p>
          </div>
        </div>

        <!-- Contacto Directo -->
        <div class="bg-[#f0f0f0] p-3 win-border">
          <h3 class="font-bold text-[#000080] mb-2 border-b border-gray-300 pb-1">📞 DIRECT CONTACT</h3>
          <div class="flex flex-col gap-2 text-xs">
            <div class="flex flex-wrap items-baseline gap-x-2">
              <span class="font-bold min-w-[50px]">Email:</span> 
              <a href="mailto:czarzuelamor@gmail.com" class="text-blue-700 underline font-semibold hover:text-blue-900 break-all">czarzuelamor@gmail.com</a>
            </div>
            <div class="flex flex-wrap items-baseline gap-x-2">
              <span class="font-bold min-w-[50px]">Phone:</span> 
              <a href="tel:+34600080462" class="text-blue-700 underline font-semibold hover:text-blue-900">+34 600 080 462</a>
            </div>
            <div class="flex flex-wrap items-baseline gap-x-2">
              <span class="font-bold min-w-[50px]">Location:</span> 
              <span class="text-gray-800">Madrid, España (28022)</span>
            </div>
          </div>
        </div>

        <!-- Secciones de Historia y Habilidades -->
        <div class="flex flex-col gap-4">
          <div class="space-y-3">
            <h3 class="font-bold text-[#000080] border-b border-gray-300 pb-1">🎓 ACADEMIC HISTORY</h3>
            <div>
              <p class="font-bold text-gray-900">Universidad Complutense de Madrid (UCM)</p>
              <p class="text-[11px] text-gray-600">Bachelor’s Degree in Video Game Development | 2021-2025</p>
              <ul class="list-disc list-inside mt-1 space-y-1 text-gray-800">
                <li>Member of Mentoring Club - Assisted junior students.</li>
                <li>Participated in coding challenges & Game Jams.</li>
              </ul>
            </div>
            <div>
              <p class="font-bold text-gray-900">Dakota Ridge High School (Colorado, USA)</p>
              <p class="text-[11px] text-gray-600">Exchange Program | 2018-2019</p>
              <ul class="list-disc list-inside mt-1 text-gray-800">
                <li>Gained international experience & English fluency.</li>
              </ul>
            </div>
          </div>

          <div class="space-y-2">
            <h3 class="font-bold text-[#000080] border-b border-gray-300 pb-1">⚡ TECHNICAL SKILLS</h3>
            <p><strong>Languages:</strong> C++, C#, C, Python, Java, JavaScript</p>
            <p><strong>Game Engines:</strong> Unreal Engine 5, Unity, Godot</p>
            <p><strong>Platforms:</strong> PS5 Dev, Android, Meta Quest (VR)</p>
            <p><strong>Software Dev:</strong> Architecture, Video Games, App Dev</p>
            <p><strong>Tools:</strong> Git, Visual Studio, Blender, FMOD, Reaper</p>
          </div>
        </div>
      </div>
    </Window>

    <Taskbar />

    <!-- Alerta de Poco Espacio en Disco -->
    <div 
      id="low-disk-warning" 
      class="hidden fixed bottom-12 right-3 z-50 bg-[#ffffe1] border border-black p-2.5 shadow-md max-w-xs text-xs font-sans text-black flex items-start gap-2.5 animate-bounce"
    >
      <span class="text-xl">⚠️</span>
      <div class="flex-1">
        <div class="flex justify-between items-center font-bold mb-1">
          <span>Low Disk Space</span>
          <button onclick="document.getElementById('low-disk-warning').classList.add('hidden')" class="hover:bg-gray-200 px-1 font-mono font-bold">✕</button>
        </div>
        <p class="leading-tight text-gray-800"> You are running very low on disk space on (C:). To free space on this drive, click here.</p>
        <button onclick="alert('🗑️ Liberando espacio...\n\nSe han eliminado 0KB. Por favor, contrata a Claudia para optimizar la memoria.')" class="mt-2 text-[#000080] font-bold underline cursor-pointer hover:text-blue-600 block">
          Disk Cleanup...
        </button>
      </div>
    </div>

    <script is:inline>
      setTimeout(() => {
        const alertBox = document.getElementById('low-disk-warning');
        if (alertBox) alertBox.classList.remove('hidden');
      }, 4000);
    </script>

    <!-- JS de control global con soporte de rescalado + límites -->
    <script is:inline>
      let zIndexCounter = 40;

      window.bringToFront = function(win) {
        zIndexCounter++;
        win.style.zIndex = zIndexCounter;
      };

      window.openWin = function(id) {
        const win = document.getElementById(id);
        if (win) {
          win.classList.remove('hidden');
          window.bringToFront(win);
        }
      };

      window.closeWin = function(id) {
        const win = document.getElementById(id);
        if (win) win.classList.add('hidden');
      };

      window.toggleMaximize = function(id, defaultW, defaultH, maxW, maxH) {
        const win = document.getElementById(id);
        if (!win) return;
        
        if (win.dataset.maximized === "true") {
          win.style.width = defaultW;
          win.style.height = defaultH;
          win.dataset.maximized = "false";
        } else {
          win.style.width = maxW || "85vw";
          win.style.height = maxH || "calc(100vh - 60px)";
          win.dataset.maximized = "true";
        }
        window.bringToFront(win);
      };

      function initWindowManager() {
        document.querySelectorAll('.win-resizable').forEach(win => {
          const header = win.querySelector('.window-header');
          let isDragging = false;
          let offsetX = 0, offsetY = 0;

          win.addEventListener('mousedown', () => window.bringToFront(win));

          if (header) {
            header.addEventListener('mousedown', (e) => {
              if (e.target.tagName === 'BUTTON') return;
              isDragging = true;
              offsetX = e.clientX - win.offsetLeft;
              offsetY = e.clientY - win.offsetTop;
              window.bringToFront(win);
            });
          }

          document.addEventListener('mousemove', (e) => {
            if (isDragging) {
              let newX = e.clientX - offsetX;
              let newY = e.clientY - offsetY;

              const maxLeft = window.innerWidth - win.offsetWidth;
              const maxTop = window.innerHeight - win.offsetHeight - 40;

              newX = Math.max(0, Math.min(newX, maxLeft));
              newY = Math.max(0, Math.min(newY, maxTop));

              win.style.left = newX + 'px';
              win.style.top = newY + 'px';
            }
          });

          document.addEventListener('mouseup', () => { isDragging = false; });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initWindowManager);
      } else {
        initWindowManager();
      }
    </script>
  </body>
</html>