---
import '../styles/global.css';
import { PROJECTS } from '../data/projects';
import Window from '../components/Window.astro';
import DesktopGrid from '../components/DesktopGrid.astro';
import ProjectCard from '../components/ProjectCard.astro';
import DetailWindow from '../components/DetailWindow.astro';
import Taskbar from '../components/Taskbar.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Claudia OS - Windows 98</title>
  </head>

  <body class="bg-[#008080] text-sm min-h-screen overflow-hidden select-none relative">

    <!-- Iconos del Escritorio -->
    <DesktopGrid />

    <!-- Ventana: About Me -->
    <Window id="win-about" title="💻 About_Me.exe" defaultW="380px" defaultH="300px">
      <div class="p-3 overflow-y-auto flex-1 win-scroll flex flex-col justify-between">
        <div class="flex items-start gap-3 mb-4">
          <div class="text-4xl">👤</div>
          <div>
            <h2 class="text-base font-bold">Claudia Zarzuela Amor</h2>
            <p class="text-xs text-gray-700">Game Dev & Software Engineer</p>
          </div>
        </div>
        <div class="bg-white win-border-inset p-3 text-black text-xs space-y-2">
          <p><strong>Level:</strong> Pro</p>
          <p><strong>Tech Stack:</strong> C++, Unreal Engine 5, VR Systems, AI Integration.</p>
        </div>
        <div class="flex justify-end pt-2">
          <button onclick="closeWin('win-about')" class="bg-[#c0c0c0] px-4 py-1 win-border win-btn text-xs font-bold cursor-pointer">OK</button>
        </div>
      </div>
    </Window>

    <!-- Ventana: Lista de Proyectos -->
    <Window id="win-projects" title="📁 C:\Portfolio\Projects" defaultW="600px" defaultH="380px">
      <div class="p-3 bg-white win-border-inset flex-1 overflow-y-auto win-scroll space-y-4">
        {PROJECTS.map((proj) => (
          <ProjectCard 
            id={proj.id}
            title={proj.title}
            tag={proj.tag}
            shortDesc={proj.shortDesc}
          />
        ))}
      </div>
    </Window>

    <!-- Ventanas Modales de Detalle (Generadas automáticamente) -->
    {PROJECTS.map((proj) => (
      <DetailWindow 
        id={proj.id}
        title={proj.title}
        description={proj.detail.description}
        whatIDid={proj.detail.whatIDid}
        mediaUrl={proj.detail.mediaUrl}
        githubUrl={proj.detail.githubUrl}
        demoUrl={proj.detail.demoUrl}
      />
    ))}

    <!-- Ventana Easter Egg (Half-Life 3) -->
    <Window id="win-hl3" title="⚠️ Error" defaultW="300px" defaultH="150px">
      <div class="p-4 flex flex-col items-center justify-center gap-3 text-center">
        <p class="text-xs">hl3.exe has performed an illegal operation and will be closed.</p>
        <button onclick="closeWin('win-hl3')" class="bg-[#c0c0c0] px-4 py-1 win-border win-btn text-xs font-bold cursor-pointer">Cancel</button>
      </div>
    </Window>

    <!-- Barra de Tareas -->
    <Taskbar />

    <script src="../scripts/wm.js"></script>
  </body>
</html>