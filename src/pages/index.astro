---
import '../styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Claudia OS - Windows 98 Edition</title>
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">

		<style>
			/* Biseles Retro Estilo Windows 95/98 */
			.win-border {
				border: 3px solid #000;
				border-top-color: #dfdfdf;
				border-left-color: #dfdfdf;
				border-right-color: #808080;
				border-bottom-color: #808080;
			}
			.win-border-inset {
				border: 2px solid #000;
				border-top-color: #808080;
				border-left-color: #808080;
				border-right-color: #dfdfdf;
				border-bottom-color: #dfdfdf;
			}
			.win-btn:active {
				border-top-color: #808080;
				border-left-color: #808080;
				border-right-color: #dfdfdf;
				border-bottom-color: #dfdfdf;
			}
		</style>
	</head>

	<body class="bg-[#008080] font-['VT323'] text-xl min-h-screen overflow-hidden select-none relative">

		<!-- ICONOS DEL ESCRITORIO -->
		<div class="p-6 grid grid-cols-1 gap-6 w-32 relative z-10">
			
			<button onclick="openWin('win-about')" class="flex flex-col items-center gap-1 group cursor-pointer">
				<div class="w-12 h-12 bg-[#c0c0c0] win-border flex items-center justify-center text-2xl group-hover:bg-[#000080] group-hover:text-white">
					💻
				</div>
				<span class="text-white text-base bg-[#008080] px-1 group-hover:bg-[#000080]">About_Me.exe</span>
			</button>

			<button onclick="openWin('win-projects')" class="flex flex-col items-center gap-1 group cursor-pointer">
				<div class="w-12 h-12 bg-[#c0c0c0] win-border flex items-center justify-center text-2xl group-hover:bg-[#000080] group-hover:text-white">
					📁
				</div>
				<span class="text-white text-base bg-[#008080] px-1 group-hover:bg-[#000080]">Projects</span>
			</button>

			<button onclick="openWin('win-skills')" class="flex flex-col items-center gap-1 group cursor-pointer">
				<div class="w-12 h-12 bg-[#c0c0c0] win-border flex items-center justify-center text-2xl group-hover:bg-[#000080] group-hover:text-white">
					🕹️
				</div>
				<span class="text-white text-base bg-[#008080] px-1 group-hover:bg-[#000080]">Skills.dll</span>
			</button>

		</div>

		<!-- VENTANA 1: ABOUT ME (BIENVENIDA) -->
		<div id="win-about" class="absolute top-12 left-1/2 -translate-x-1/2 w-[90%] max-w-lg bg-[#c0c0c0] win-border p-1 shadow-2xl z-20">
			<!-- Barra de Título -->
			<div class="bg-[#000080] text-white px-2 py-1 flex justify-between items-center font-bold text-lg">
				<span class="flex items-center gap-2">💾 Welcome - Claudia Zarzuela</span>
				<button onclick="closeWin('win-about')" class="w-5 h-5 bg-[#c0c0c0] text-black win-border win-btn flex items-center justify-center text-xs font-bold">X</button>
			</div>
			<!-- Contenido -->
			<div class="p-4">
				<div class="bg-white win-border-inset p-4 mb-4 text-black space-y-2">
					<h2 class="text-2xl font-bold text-[#000080]">Claudia Zarzuela Amor</h2>
					<p class="text-lg">Game Developer & Software Engineer</p>
					<hr class="border-gray-400" />
					<p class="text-base leading-snug">
						Specializing in Game Engines, C++, Unreal Engine 5, VR Systems, and AI integration. Welcome to my retro OS portfolio!
					</p>
				</div>
				<div class="flex justify-end gap-2">
					<button onclick="openWin('win-projects')" class="bg-[#c0c0c0] px-4 py-1 win-border win-btn text-base font-bold">View Projects &gt;</button>
				</div>
			</div>
		</div>

		<!-- VENTANA 2: PROJECTS -->
		<div id="win-projects" class="hidden absolute top-20 left-1/2 -translate-x-1/2 w-[90%] max-w-2xl bg-[#c0c0c0] win-border p-1 shadow-2xl z-30">
			<div class="bg-[#000080] text-white px-2 py-1 flex justify-between items-center font-bold text-lg">
				<span class="flex items-center gap-2">📁 C:\Portfolio\Projects</span>
				<button onclick="closeWin('win-projects')" class="w-5 h-5 bg-[#c0c0c0] text-black win-border win-btn flex items-center justify-center text-xs font-bold">X</button>
			</div>
			<div class="p-4 space-y-4">
				
				<!-- Proyecto 1 -->
				<div class="bg-white win-border-inset p-3 text-black">
					<div class="flex justify-between items-center mb-1">
						<span class="font-bold text-xl text-[#000080]">🎮 VR LLM Interaction System</span>
						<span class="text-xs bg-[#c0c0c0] px-1 border border-black">UE5 / C++</span>
					</div>
					<p class="text-base mb-2">Bachelor Thesis Project. VR game prototype executing dynamic open-source LLM prompts through custom Blueprints.</p>
					<a href="https://github.com/tyzarzuela" target="_blank" class="text-[#000080] underline font-bold text-base">[Open Repository]</a>
				</div>

				<!-- Proyecto 2 -->
				<div class="bg-white win-border-inset p-3 text-black">
					<div class="flex justify-between items-center mb-1">
						<span class="font-bold text-xl text-[#000080]">⚙️ EDEN Custom Engine</span>
						<span class="text-xs bg-[#c0c0c0] px-1 border border-black">C++ / Architecture</span>
					</div>
					<p class="text-base mb-2">2D/3D game engine built from scratch in C++. Features modular ECS, custom rendering pipeline, and physics.</p>
					<a href="https://github.com/tyzarzuela" target="_blank" class="text-[#000080] underline font-bold text-base">[Open Repository]</a>
				</div>

			</div>
		</div>

		<!-- BARRA DE TAREAS (TASKBAR WINDOWS 98) -->
		<div class="fixed bottom-0 left-0 w-full h-10 bg-[#c0c0c0] border-t-2 border-white flex justify-between items-center px-1 z-50">
			
			<!-- Botón Inicio -->
			<div class="relative">
				<button id="start-btn" onclick="toggleStartMenu()" class="h-8 px-2 bg-[#c0c0c0] win-border win-btn flex items-center gap-1 font-bold text-lg cursor-pointer">
					<span class="text-base">🪟</span>
					<span>Start</span>
				</button>

				<!-- Menú Inicio desplegable -->
				<div id="start-menu" class="hidden absolute bottom-10 left-0 w-48 bg-[#c0c0c0] win-border p-1 shadow-2xl flex flex-col gap-1">
					<div class="bg-[#000080] text-white p-2 font-bold text-base flex items-center gap-2">
						<span class="rotate-[-90deg] text-xs tracking-widest">WIN98</span>
						<span>ClaudiaOS</span>
					</div>
					<button onclick="openWin('win-about'); toggleStartMenu()" class="p-2 text-left hover:bg-[#000080] hover:text-white flex items-center gap-2 text-base">💻 About Me</button>
					<button onclick="openWin('win-projects'); toggleStartMenu()" class="p-2 text-left hover:bg-[#000080] hover:text-white flex items-center gap-2 text-base">📁 Projects</button>
					<a href="https://github.com/tyzarzuela" target="_blank" class="p-2 text-left hover:bg-[#000080] hover:text-white flex items-center gap-2 text-base">👾 GitHub</a>
					<hr class="border-gray-500 my-1" />
					<a href="mailto:czarzuelamor@gmail.com" class="p-2 text-left hover:bg-[#000080] hover:text-white flex items-center gap-2 text-base">✉️ Contact Me</a>
				</div>
			</div>

			<!-- Reloj de la barra de tareas -->
			<div class="h-8 px-3 bg-[#c0c0c0] win-border-inset flex items-center text-base font-bold text-black" id="win-clock">
				12:00 PM
			</div>

		</div>

		<!-- SCRIPTS DE INTERACCIÓN -->
		<script is:inline>
			function openWin(id) {
				document.getElementById(id).classList.remove('hidden');
			}
			function closeWin(id) {
				document.getElementById(id).classList.add('hidden');
			}
			function toggleStartMenu() {
				const menu = document.getElementById('start-menu');
				menu.classList.toggle('hidden');
			}

			// Actualizar Reloj
			function updateClock() {
				const now = new Date();
				let hours = now.getHours();
				let minutes = now.getMinutes();
				const ampm = hours >= 12 ? 'PM' : 'AM';
				hours = hours % 12 || 12;
				minutes = minutes < 10 ? '0' + minutes : minutes;
				document.getElementById('win-clock').innerText = `${hours}:${minutes} ${ampm}`;
			}
			setInterval(updateClock, 1000);
			updateClock();
		</script>

	</body>
</html>