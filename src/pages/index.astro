---
import '../styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Claudia OS - Windows 98 Edition</title>
		
		<style>
			body {
				font-family: Tahoma, 'Segoe UI', Geneva, Verdana, sans-serif;
			}
			.win-border {
				border: 2px solid;
				border-top-color: #dfdfdf;
				border-left-color: #dfdfdf;
				border-right-color: #000000;
				border-bottom-color: #000000;
				box-shadow: inset 1px 1px 0px 0px #ffffff, inset -1px -1px 0px 0px #808080;
			}
			.win-border-inset {
				border: 2px solid;
				border-top-color: #808080;
				border-left-color: #808080;
				border-right-color: #ffffff;
				border-bottom-color: #ffffff;
				box-shadow: inset 1px 1px 0px 0px #000000, inset -1px -1px 0px 0px #dfdfdf;
			}
			.win-btn:active {
				border-top-color: #000000;
				border-left-color: #000000;
				border-right-color: #ffffff;
				border-bottom-color: #ffffff;
				box-shadow: inset 1px 1px 0px 0px #808080;
			}
			.title-bar-gradient {
				background: linear-gradient(90deg, #000080 0%, #1084d0 100%);
			}
			
			/* Clase de ventana maximizada */
			.window-maximized {
				top: 0 !important;
				left: 0 !important;
				width: 100vw !important;
				height: calc(100vh - 40px) !important;
				max-width: none !important;
				max-height: none !important;
				margin: 0 !important;
			}
		</style>
	</head>

	<body class="bg-[#008080] text-sm min-h-screen overflow-hidden select-none relative">

		<!-- ICONOS DEL ESCRITORIO (IZQUIERDA) -->
		<div class="absolute top-6 left-6 flex flex-col gap-6 w-24 z-10">
			<button onclick="openWin('win-about')" class="flex flex-col items-center gap-1 group cursor-pointer">
				<div class="w-10 h-10 bg-[#008080] flex items-center justify-center text-3xl">💻</div>
				<span class="text-white text-xs text-center leading-tight px-1 group-focus:bg-[#000080]">About_Me.exe</span>
			</button>

			<button onclick="openWin('win-projects')" class="flex flex-col items-center gap-1 group cursor-pointer">
				<div class="w-10 h-10 bg-[#008080] flex items-center justify-center text-3xl">📁</div>
				<span class="text-white text-xs text-center leading-tight px-1 group-focus:bg-[#000080]">Projects</span>
			</button>
		</div>

		<!-- ICONOS DEL ESCRITORIO (DERECHA) -->
		<div class="absolute bottom-16 right-6 flex flex-col gap-6 w-24 z-10 items-end">
			<button onclick="alert('Iniciando Hollow Knight... 🐛')" class="flex flex-col items-center gap-1 group cursor-pointer">
				<div class="text-3xl">🗡️</div>
				<span class="text-white text-xs text-center leading-tight px-1 group-focus:bg-[#000080]">Hollow_Knight</span>
			</button>

			<button onclick="alert('Half-Life 3 aún no confirmado. ☢️')" class="flex flex-col items-center gap-1 group cursor-pointer">
				<div class="text-3xl">☢️</div>
				<span class="text-white text-xs text-center leading-tight px-1 group-focus:bg-[#000080]">Half_Life</span>
			</button>
			
			<button onclick="alert('ERROR: Demasiadas ideas sin terminar. 🗑️')" class="flex flex-col items-center gap-1 group cursor-pointer">
				<div class="text-3xl">🗑️</div>
				<span class="text-white text-xs text-center leading-tight px-1 group-focus:bg-[#000080]">Scrapped_Ideas</span>
			</button>
		</div>

		<!-- VENTANA 1: ABOUT ME -->
		<div id="win-about" class="hidden absolute top-12 left-12 w-[350px] bg-[#c0c0c0] win-border p-[2px] shadow-2xl z-20 flex flex-col">
			<!-- Barra de Título (Para arrastrar) -->
			<div class="window-header title-bar-gradient text-white px-1 py-[2px] flex justify-between items-center font-bold text-sm cursor-move">
				<span class="flex items-center gap-1 pointer-events-none">
					💻 About_Me.exe
				</span>
				<div class="flex gap-[2px]">
					<button onclick="toggleMaximize('win-about')" class="w-4 h-4 bg-[#c0c0c0] text-black win-border win-btn flex items-center justify-center text-xs font-bold">◻</button>
					<button onclick="closeWin('win-about')" class="w-4 h-4 bg-[#c0c0c0] text-black win-border win-btn flex items-center justify-center text-xs font-bold">X</button>
				</div>
			</div>
			<!-- Contenido con Scroll Funcional -->
			<div class="p-3 overflow-y-auto flex-1 max-h-[400px]">
				<div class="flex items-start gap-3 mb-4">
					<div class="text-4xl">👤</div>
					<div>
						<h2 class="text-base font-bold">Claudia Zarzuela Amor</h2>
						<p class="text-xs text-gray-700">Game Dev & Software Engineer</p>
					</div>
				</div>
				<div class="bg-white win-border-inset p-3 text-black text-xs space-y-2 mb-4">
					<p><strong>Level:</strong> Pro</p>
					<p><strong>Tech Stack:</strong> C++, Unreal Engine 5, VR Systems, AI Integration.</p>
					<p class="text-gray-600">Specialized in gameplay architecture and custom engine development.</p>
				</div>
				<div class="flex justify-end">
					<button onclick="closeWin('win-about')" class="bg-[#c0c0c0] px-4 py-1 win-border win-btn text-xs font-bold cursor-pointer">OK</button>
				</div>
			</div>
		</div>

		<!-- VENTANA 2: PROJECTS -->
		<div id="win-projects" class="hidden absolute top-20 left-24 w-[90%] max-w-2xl h-[450px] bg-[#c0c0c0] win-border p-[2px] shadow-2xl z-30 flex flex-col">
			<!-- Barra de Título (Para arrastrar) -->
			<div class="window-header title-bar-gradient text-white px-1 py-[2px] flex justify-between items-center font-bold text-sm cursor-move">
				<span class="flex items-center gap-1 pointer-events-none">
					📁 C:\Portfolio\Projects
				</span>
				<div class="flex gap-[2px]">
					<button onclick="toggleMaximize('win-projects')" class="w-4 h-4 bg-[#c0c0c0] text-black win-border win-btn flex items-center justify-center text-xs font-bold">◻</button>
					<button onclick="closeWin('win-projects')" class="w-4 h-4 bg-[#c0c0c0] text-black win-border win-btn flex items-center justify-center text-xs font-bold">X</button>
				</div>
			</div>

			<!-- Barra de menú -->
			<div class="flex gap-4 px-2 py-1 bg-[#c0c0c0] border-b border-gray-400 text-xs">
				<span class="hover:bg-blue-800 hover:text-white px-1 cursor-pointer">File</span>
				<span class="hover:bg-blue-800 hover:text-white px-1 cursor-pointer">Edit</span>
				<span class="hover:bg-blue-800 hover:text-white px-1 cursor-pointer">View</span>
			</div>
			
			<!-- Contenido con Scroll Funcional -->
			<div class="p-3 m-1 bg-white win-border-inset flex-1 overflow-y-auto space-y-4">
				
				<div class="border-b border-gray-300 pb-3">
					<div class="flex justify-between items-center mb-1">
						<span class="font-bold text-[#000080] text-base flex items-center gap-2">
							🎮 VR LLM Interaction System
						</span>
						<span class="text-xs bg-[#c0c0c0] px-2 py-0.5 win-border-inset">UE5 / C++</span>
					</div>
					<p class="text-xs mb-2 text-gray-800">Bachelor thesis project. VR game prototype executing dynamic open-source LLM prompts through custom Blueprints.</p>
					<a href="https://github.com/tyzarzuela" target="_blank" class="text-blue-600 underline text-xs font-bold">Explore Source Code &rarr;</a>
				</div>

				<div class="border-b border-gray-300 pb-3">
					<div class="flex justify-between items-center mb-1">
						<span class="font-bold text-[#000080] text-base flex items-center gap-2">
							⚙️ EDEN Custom Engine
						</span>
						<span class="text-xs bg-[#c0c0c0] px-2 py-0.5 win-border-inset">C++ / ECS</span>
					</div>
					<p class="text-xs mb-2 text-gray-800">2D/3D game engine built from scratch in C++. Features modular ECS, custom rendering pipeline, and physics.</p>
					<a href="https://github.com/tyzarzuela" target="_blank" class="text-blue-600 underline text-xs font-bold">Explore Source Code &rarr;</a>
				</div>

				<!-- Elementos adicionales para forzar el Scroll -->
				<div class="border-b border-gray-300 pb-3">
					<div class="flex justify-between items-center mb-1">
						<span class="font-bold text-[#000080] text-base">🕹️ Gameplay Prototypes</span>
						<span class="text-xs bg-[#c0c0c0] px-2 py-0.5 win-border-inset">Unreal / Unity</span>
					</div>
					<p class="text-xs mb-2 text-gray-800">Collection of experimental mechanics, AI behavior trees, and procedural shaders.</p>
				</div>

				<div class="p-3 bg-yellow-100 border border-yellow-400 rounded flex items-center gap-3">
					<span class="text-xl">⚠️</span>
					<div>
						<p class="font-bold text-red-600 text-xs">Top_Secret_Game_Idea.txt</p>
						<button onclick="alert('Access Denied: The world is not ready for a Battle Royale with pigeons yet. 🐦')" class="text-xs text-blue-600 underline cursor-pointer">Open File</button>
					</div>
				</div>

			</div>
		</div>

		<!-- BARRA DE TAREAS -->
		<div class="fixed bottom-0 left-0 w-full h-10 bg-[#c0c0c0] border-t-2 border-white flex justify-between items-center px-1 z-50">
			<div class="relative">
				<button id="start-btn" onclick="toggleStartMenu()" class="h-8 px-2 bg-[#c0c0c0] win-border win-btn flex items-center gap-2 font-bold text-black cursor-pointer">
					<span class="text-base">🪟</span>
					<span>Start</span>
				</button>

				<div id="start-menu" class="hidden absolute bottom-10 left-0 w-56 bg-[#c0c0c0] win-border p-[2px] shadow-2xl flex">
					<div class="w-8 bg-gradient-to-b from-[#000080] to-[#1084d0] flex flex-col justify-end p-1">
						<span class="text-white text-xs font-bold -rotate-90 origin-left whitespace-nowrap mb-8 tracking-widest">ClaudiaOS</span>
					</div>
					<div class="flex-1 flex flex-col py-1 bg-[#c0c0c0]">
						<button onclick="openWin('win-about'); toggleStartMenu()" class="px-3 py-2 text-left hover:bg-[#000080] hover:text-white flex items-center gap-2 text-xs">💻 About Me</button>
						<button onclick="openWin('win-projects'); toggleStartMenu()" class="px-3 py-2 text-left hover:bg-[#000080] hover:text-white flex items-center gap-2 text-xs">📁 Projects</button>
						<a href="https://github.com/tyzarzuela" target="_blank" class="px-3 py-2 text-left hover:bg-[#000080] hover:text-white flex items-center gap-2 text-xs">👾 GitHub</a>
						<div class="h-[2px] bg-gray-400 border-b border-white my-1 mx-1"></div>
						<a href="mailto:czarzuelamor@gmail.com" class="px-3 py-2 text-left hover:bg-[#000080] hover:text-white flex items-center gap-2 text-xs">✉️ Contact</a>
					</div>
				</div>
			</div>

			<div class="h-7 px-3 bg-[#c0c0c0] win-border-inset flex items-center text-xs text-black" id="win-clock">
				12:00 PM
			</div>
		</div>

		<!-- SISTEMA DRAG & DROP Y CONTROL DE VENTANAS -->
		<script is:inline>
			let zIndexCounter = 40;

			function bringToFront(win) {
				zIndexCounter++;
				win.style.zIndex = zIndexCounter;
			}

			function openWin(id) {
				const win = document.getElementById(id);
				win.classList.remove('hidden');
				bringToFront(win);
			}

			function closeWin(id) {
				document.getElementById(id).classList.add('hidden');
			}

			function toggleMaximize(id) {
				const win = document.getElementById(id);
				win.classList.toggle('window-maximized');
				bringToFront(win);
			}

			function toggleStartMenu() {
				document.getElementById('start-menu').classList.toggle('hidden');
			}

			// SISTEMA PARA ARRASTRAR VENTANAS (DRAG & DROP)
			document.querySelectorAll('[id^="win-"]').forEach(win => {
				const header = win.querySelector('.window-header');
				let isDragging = false;
				let offsetX = 0, offsetY = 0;

				win.addEventListener('mousedown', () => bringToFront(win));

				if (header) {
					header.addEventListener('mousedown', (e) => {
						if (e.target.tagName === 'BUTTON') return; // Evitar arrastrar si se pulsa X o Maximizar
						if (win.classList.contains('window-maximized')) return; // No arrastrar si está maximizado

						isDragging = true;
						offsetX = e.clientX - win.offsetLeft;
						offsetY = e.clientY - win.offsetTop;
						bringToFront(win);
					});
				}

				document.addEventListener('mousemove', (e) => {
					if (isDragging) {
						win.style.left = (e.clientX - offsetX) + 'px';
						win.style.top = (e.clientY - offsetY) + 'px';
					}
				});

				document.addEventListener('mouseup', () => {
					isDragging = false;
				});
			});

			// Reloj
			function updateClock() {
				const now = new Date();
				let hours = now.getHours();
				let minutes = now.getMinutes();
				const ampm = hours >= 12 ? 'PM' : 'AM';
				hours = hours % 12 || 12;
				minutes = minutes < 10 ? '0' + minutes : minutes;
				document.getElementById('win-clock').innerText = `${hours}:${minutes} ${ampm}`;
			}
			setInterval(updateClock, 1000);
			updateClock();
		</script>
	</body>
</html>