---
import '../styles/global.css';
---

<html lang="en" class="scroll-smooth cursor-none">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Claudia Zarzuela | Game Developer & Software Engineer</title>
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
	</head>
	<body class="bg-indigo-950 text-amber-100 font-['VT323'] text-xl antialiased min-h-screen selection:bg-pink-500 selection:text-white relative overflow-x-hidden">
		
		<!-- CURSOR ARCADE PERSONALIZADO -->
		<div id="arcade-cursor" class="fixed pointer-events-none z-50 -translate-x-1/2 -translate-y-1/2 transition-transform duration-75">
			<div class="w-8 h-8 border-2 border-pink-400 rounded-full flex items-center justify-center animate-spin" style="animation-duration: 8s;">
				<div class="w-2 h-2 bg-yellow-300 rounded-full"></div>
			</div>
			<div class="absolute inset-0 flex items-center justify-center text-pink-400 font-['Press_Start_2P'] text-[8px] opacity-70">+</div>
		</div>

		<!-- CANVAS DE FONDO INTERACTIVO (RETRO GRID & PAC-PIXELS) -->
		<canvas id="bg-canvas" class="fixed top-0 left-0 w-full h-full pointer-events-none -z-10"></canvas>

		<!-- NAVBAR -->
		<nav class="sticky top-0 z-40 backdrop-blur-md bg-indigo-950/80 border-b-4 border-pink-500">
			<div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
				<span class="font-bold text-sm text-yellow-300 font-['Press_Start_2P'] animate-pulse">CZ.DEV 👾</span>
				<div class="flex gap-6 text-lg font-['Press_Start_2P'] text-xs">
					<a href="#projects" class="text-cyan-300 hover:text-yellow-300 transition-colors">[PROJECTS]</a>
					<a href="#skills" class="text-pink-400 hover:text-yellow-300 transition-colors">[SKILLS]</a>
					<a href="#contact" class="text-emerald-400 hover:text-yellow-300 transition-colors">[CONTACT]</a>
				</div>
			</div>
		</nav>

		<!-- HERO SECTION -->
		<section class="max-w-5xl mx-auto px-6 py-16 flex flex-col items-start gap-6 relative">
			<div class="w-full flex justify-between items-center bg-indigo-900/60 p-3 rounded-lg border-2 border-pink-500/50">
				<div class="inline-flex items-center gap-2 text-yellow-300 text-xs font-['Press_Start_2P']">
					<span class="text-pink-500 animate-bounce">🕹️</span> PRESS START TO EXPLORE
				</div>
				<div class="flex items-center gap-1 text-xs font-['Press_Start_2P']">
					<span class="text-rose-500">❤️</span>
					<span class="text-rose-500">❤️</span>
					<span class="text-rose-500">❤️</span>
					<span class="text-yellow-300 ml-2">HIGH SCORE: 99999</span>
				</div>
			</div>

			<h1 class="text-5xl md:text-7xl font-bold tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-yellow-300 via-pink-400 to-cyan-300 font-['Press_Start_2P'] leading-tight py-2">
				Claudia Zarzuela
			</h1>

			<p class="text-cyan-200 text-2xl max-w-2xl leading-relaxed bg-indigo-900/40 p-4 rounded-xl border border-cyan-500/30">
				Game Developer & Software Engineer. Specializing in Game Engines, C++, VR Systems, and Gameplay Architecture.
			</p>
			
			<div class="flex flex-wrap gap-4 pt-2">
				<a href="#projects" class="px-6 py-3 rounded-lg bg-pink-500 hover:bg-pink-400 text-indigo-950 font-['Press_Start_2P'] text-xs font-bold transition-all shadow-[4px_4px_0px_0px_rgba(253,224,71,1)] active:translate-x-1 active:translate-y-1 active:shadow-none">
					🎮 SELECT STAGE
				</a>
				<a href="https://github.com/tyzarzuela" target="_blank" class="px-6 py-3 rounded-lg bg-indigo-900 hover:bg-indigo-800 border-2 border-cyan-400 text-cyan-300 font-['Press_Start_2P'] text-xs transition-all shadow-[4px_4px_0px_0px_rgba(34,211,238,1)]">
					👾 GITHUB PROFILE
				</a>
			</div>
		</section>

		<!-- ARCADE STAGES / PROJECTS -->
		<section id="projects" class="max-w-5xl mx-auto px-6 py-12">
			<div class="flex items-center justify-between mb-8 border-b-2 border-yellow-300/40 pb-4">
				<h2 class="text-xl md:text-2xl font-['Press_Start_2P'] text-yellow-300">
					STAGE 1: FEATURED GAMES
				</h2>
				<span class="text-xs font-['Press_Start_2P'] text-pink-400 animate-pulse">INSERT COIN</span>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
				
				<!-- CABINET 1 -->
				<div class="bg-indigo-900/80 border-4 border-pink-500 rounded-2xl p-6 shadow-[8px_8px_0px_0px_rgba(236,72,153,0.4)] hover:shadow-[12px_12px_0px_0px_rgba(236,72,153,0.8)] transition-all">
					<div class="flex justify-between items-center mb-4 text-xs font-['Press_Start_2P'] text-cyan-300">
						<span>[UNREAL ENGINE 5]</span>
						<span>VR / AI</span>
					</div>
					<h3 class="text-2xl font-bold mb-3 text-yellow-300 font-['Press_Start_2P'] text-base">
						VR LLM Interaction
					</h3>
					<p class="text-slate-200 text-xl mb-4">
						Bachelor Thesis Project. VR interactions dynamically powered by LLMs in UE5 via custom Blueprints.
					</p>
					<a href="https://github.com/tyzarzuela" target="_blank" class="inline-block px-4 py-2 bg-cyan-400 text-indigo-950 font-['Press_Start_2P'] text-[10px] font-bold rounded hover:bg-yellow-300 transition-colors">
						VIEW REPO &rarr;
					</a>
				</div>

				<!-- CABINET 2 -->
				<div class="bg-indigo-900/80 border-4 border-cyan-400 rounded-2xl p-6 shadow-[8px_8px_0px_0px_rgba(34,211,238,0.4)] hover:shadow-[12px_12px_0px_0px_rgba(34,211,238,0.8)] transition-all">
					<div class="flex justify-between items-center mb-4 text-xs font-['Press_Start_2P'] text-pink-400">
						<span>[C++ ENGINE]</span>
						<span>ARCHITECTURE</span>
					</div>
					<h3 class="text-2xl font-bold mb-3 text-yellow-300 font-['Press_Start_2P'] text-base">
						EDEN Engine
					</h3>
					<p class="text-slate-200 text-xl mb-4">
						2D/3D custom game engine built from scratch. Features modular ECS, custom rendering, and physics.
					</p>
					<a href="https://github.com/tyzarzuela" target="_blank" class="inline-block px-4 py-2 bg-pink-500 text-white font-['Press_Start_2P'] text-[10px] font-bold rounded hover:bg-yellow-300 hover:text-indigo-950 transition-colors">
						VIEW REPO &rarr;
					</a>
				</div>

			</div>
		</section>

		<!-- FOOTER -->
		<footer id="contact" class="max-w-5xl mx-auto px-6 py-12 border-t-4 border-pink-500 text-center">
			<p class="text-yellow-300 font-['Press_Start_2P'] text-xs mb-4">GAME OVER - THANKS FOR PLAYING!</p>
			<div class="flex justify-center gap-6 font-['Press_Start_2P'] text-xs text-cyan-300">
				<a href="mailto:czarzuelamor@gmail.com" class="hover:text-pink-400">EMAIL</a>
				<a href="https://github.com/tyzarzuela" target="_blank" class="hover:text-pink-400">GITHUB</a>
				<a href="https://linkedin.com" target="_blank" class="hover:text-pink-400">LINKEDIN</a>
			</div>
		</footer>

		<!-- SCRIPT DE INTERACTIVIDAD DEL FONDO Y CURSOR -->
		<script is:inline>
			// 1. SEGUIMIENTO DEL CURSOR ARCADE
			const cursor = document.getElementById('arcade-cursor');
			const trailParticles = [];

			window.addEventListener('mousemove', (e) => {
				cursor.style.left = e.clientX + 'px';
				cursor.style.top = e.clientY + 'px';

				// Añadir partícula al mover el ratón (Estela Arcade)
				if (Math.random() > 0.4) {
					trailParticles.push({
						x: e.clientX,
						y: e.clientY,
						size: Math.random() * 6 + 2,
						color: ['#f43f5e', '#ec4899', '#a855f7', '#38bdf8', '#fde047'][Math.floor(Math.random() * 5)],
						life: 1
					});
				}
			});

			// 2. CANVAS DE FONDO RETRO/INDIE (ESTARS & PIXELS)
			const canvas = document.getElementById('bg-canvas');
			const ctx = canvas.getContext('2d');
			let width, height;
			let stars = [];

			function resize() {
				width = canvas.width = window.innerWidth;
				height = canvas.height = window.innerHeight;
			}

			function initStars() {
				resize();
				stars = [];
				for (let i = 0; i < 80; i++) {
					stars.push({
						x: Math.random() * width,
						y: Math.random() * height,
						size: Math.random() * 3 + 1,
						color: ['#fde047', '#38bdf8', '#ec4899'][Math.floor(Math.random() * 3)],
						speed: Math.random() * 0.5 + 0.2
					});
				}
			}

			window.addEventListener('resize', initStars);

			function animate() {
				ctx.fillStyle = '#1e1b4b'; // Fondo azul/púrpura cálido
				ctx.fillRect(0, 0, width, height);

				// Dibujar estrellas de fondo
				for (let star of stars) {
					star.y += star.speed;
					if (star.y > height) star.y = 0;

					ctx.fillStyle = star.color;
					ctx.fillRect(star.x, star.y, star.size, star.size); // Dibujo pixelado (cuadrados)
				}

				// Dibujar estela interactiva del ratón
				for (let i = trailParticles.length - 1; i >= 0; i--) {
					const p = trailParticles[i];
					p.life -= 0.03;
					p.y += 0.5;

					if (p.life <= 0) {
						trailParticles.splice(i, 1);
					} else {
						ctx.fillStyle = p.color;
						ctx.globalAlpha = p.life;
						ctx.fillRect(p.x, p.y, p.size, p.size);
						ctx.globalAlpha = 1.0;
					}
				}

				requestAnimationFrame(animate);
			}

			initStars();
			animate();
		</script>
	</body>
</html>